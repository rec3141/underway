<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0f1419">
<title>{{ site.title }}</title>
<script>/* the chosen theme goes on before the first paint; app.js keeps it (Claude dark without a choice) */
(function () { try {
  var t = JSON.parse(localStorage.getItem("uw:theme")) || "auto";
  if (t === "auto") t = matchMedia("(prefers-color-scheme: light)").matches ? "claude-light" : "claude-dark";
  document.documentElement.dataset.theme = t;
  var s = JSON.parse(localStorage.getItem("uw:textsize")); if (s && s !== "auto") document.documentElement.dataset.size = s;
} catch (e) {} })();</script>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%230f1419'/%3E%3Cpath d='M6 20 Q11 14 16 18 T26 14' stroke='%235cc8ff' stroke-width='3' fill='none'/%3E%3C/svg%3E">
<link rel="stylesheet" href="static/maplibre-gl.css?v={{ site.maplibre_version }}">
<link rel="stylesheet" href="static/style.css?v={{ site.asset_version }}">
<script src="static/plotly.min.js?v={{ site.plotly_version }}"></script>
<script src="static/maplibre-gl.js?v={{ site.maplibre_version }}"></script>
</head>
<body>

<header class="top">
  <!-- Tabs and map cycler, with feedback and appearance controls at the right. -->
  <div class="tabrow">
    <nav class="tabs" id="tabs" role="tablist">
    <button data-tab="map" id="maptoggle" class="mapbtn" title="how much of the page the map takes: half, all of it, or none"><span class="ico">◧</span> Map</button>
    <button data-tab="calendar" role="tab">Schedule</button>
    <button data-tab="stations" role="tab">Stations</button>
    <button data-tab="underway" class="on" role="tab">Underway</button>
    <button data-tab="casts" role="tab">Casts</button>
    <button data-tab="sources" role="tab">Sources</button>
    <button data-tab="wiki" role="tab" title="the region's past and its nature: voyages, people, places and artifacts, the rock, the ice, the water, the sky and the living things, on the map and in a wiki, with the crew to ask">Wiki</button>
    <button data-tab="chat" role="tab" id="tabchat" title="ship chat">Chat</button>
    </nav>
    <div class="themepick">
      <button type="button" id="feedback-open" class="feedback-link">Feedback</button>
      <label class="group select" title="the look of the page: Auto follows the system's light or dark; Claude and Minimal (flat, bigger type), each dark or light; Navigator, the web of 1996"><select id="theme" aria-label="Theme"></select></label>
      <label class="group select" title="the size of the type, apart from the theme: Minimal's is large, Claude's normal, unless told otherwise"><select id="textsize" aria-label="Text size"></select></label>
    </div>
  </div>
  <div class="brand">
    <h1>{{ site.title }}</h1>
    <div class="sub" id="status">loading…</div>
    <div class="sub" id="connection" role="status" hidden></div>
  </div>
  <div class="pickhint phone">Select leg and time span:</div>
  <div class="controls" id="controls-underway">
    <details class="group legmenu" id="legmenu">
      <summary id="legsummary">Legs</summary>
      <div class="pop">
        <div class="pophead">Legs to show · <a href="#" id="legall">all</a> · <a href="#" id="legnone">none</a></div>
        <ul id="leglist"></ul>
        <div class="popfoot" id="legfoot"></div>
      </div>
    </details>
    <div class="group span" aria-label="Time span">
      <span class="lbl">Show last</span>
      <output id="spanlabel" for="span">6h</output>
      <input type="range" id="span" min="0" max="0" step="1" value="0" list="spanticks" aria-label="Time span shown">
      <datalist id="spanticks"></datalist>
      <select id="spansel" title="span" aria-label="Time span"></select>
    </div>
  </div>
</header>
<div class="inapp" id="inapp" hidden></div>
<div class="alertbar" id="alert" hidden>
  <div class="schedrow" id="schedrow">
    <div class="schedcols" id="schedcols"></div>
    <div class="schedlinks" id="schedlinks"></div>
  </div>
  <div class="ticker" id="schedticker" hidden title="show the schedule"><div class="tkwrap"><div class="tk" id="tk"></div></div><div class="tklinks" id="tickerlinks"></div></div>
</div>

<main>
  <div class="plotctl" id="plotctl">
    <div class="group xmode" aria-label="X axis"><span class="lbl">X-axis</span><button type="button" class="xcycle" title="switch the graphs between time and distance along track">Time</button></div>
    <label class="group select strip">Color by <select class="colourpick" title="the variable that colours the track and the graph points"></select><span class="cbar" hidden><span class="lo"></span><span class="grad"></span><span class="hi"></span></span></label>
  </div>
  <section class="map card">
    <div class="maplayers" id="maplayers">
      <label class="group select mapcolour">Color by <select id="colour" class="colourpick" title="the variable that colours the track and the graph points"></select><span class="cbar" hidden><span class="lo"></span><span class="grad"></span><span class="hi"></span></span></label>
      <div class="tools"><button id="mapreset" title="fit to track">⟲</button><button id="mapnone" title="no map: the pane takes the whole width">—</button><button id="mapfull" title="full map: the map takes the whole page">⤢</button></div>
      <!-- the layer pills on their own row: the ship's own together, then the places, the wiki's two, the pictures; each is an on/off toggle -->
      <div class="layers">
      <span class="pillset" title="the ship's own layers">
      <button data-layer="plan" title="the leg's planned cruise track and stations from the expedition's KMZ; drop a new KMZ or KML on the map to replace it">Plan</button>
      <button data-layer="track" title="the ship's track for the shown legs and span">Track</button>
      <button data-layer="stations" title="CTD casts (white) and stations worked without a cast, from the event log (green)"><span class="full">Stations</span><span class="short">Stns</span></button>
      <button data-layer="events" title="geolocated entries of the ship's event log, for the shown legs and span">Events</button>
      </span>
      <button data-layer="photos" title="the pictures: a camera for each day's timelapse, and the ship's own photographs from /Share; click one to play or read it">Photos</button>
      <button data-layer="history" title="the wiki's history: voyages, wrecks, winterings, places and artifacts; click one to read about it" hidden>History</button>
      <div class="mapmenu" id="maphistlayers" hidden></div>
      <button data-layer="nature" title="the wiki's nature: sightings, soundings, readings and the ship's own journal; click one to read it" hidden>Nature</button>
      <div class="mapmenu" id="mapnatlayers" hidden></div>
      <button id="satpill" class="sat" title="recent satellite imagery around the ship: Sentinel-1 radar (sees ice through cloud), then Sentinel-2 true colour" hidden>Sat</button>
      <span class="satnav" id="satnav" hidden><button id="satprev" title="the picture before">‹</button><span class="satwhen" id="satwhen"></span><button id="satnext" title="the picture after">›</button></span>
      </div>
    </div>
    <div id="map"></div>
    <div id="campop" class="campop" hidden>
      <div class="head"><b id="camtitle"></b><span id="camsub"></span>
        <button id="camprev" title="previous day">‹</button><button id="camnext" title="next day">›</button><button id="camclose" title="close">✕</button></div>
      <video id="camvideo" controls autoplay muted loop playsinline preload="metadata"></video>
      <div class="foot" id="camfoot"></div>
    </div>
    <div id="mapmsg" class="mapmsg" hidden></div>
    <div id="mapscale" class="mapscale" title="the scale at the centre of the map" hidden><span class="bar"></span><span class="lbl"></span></div>
    <div class="maptrack" title="how many track points to draw: every point of the span, or one per so many km along the track">
      <span class="lbl">Track detail</span>
      <input type="range" id="trackstep" min="0" max="7" step="1" value="7" aria-label="Track detail">
      <output id="tracksteplabel" for="trackstep">all points</output>
    </div>
    <div class="map-foot" id="mapfoot"></div>
    <div class="map-attrib" id="mapattrib"></div>
  </section>

  <section class="side">
    <div class="pane" id="pane-underway">
      <div class="panels" id="panels"></div>
      <section id="underway-table" class="card">
        <h2>Table</h2>
        <div class="pane-tools">
          <div class="group seg" id="aggrule"><button data-r="1h" class="on">Hourly</button><button data-r="1d">Daily</button></div>
          <label class="group select">Statistic <select id="aggstat"><option value="0">mean</option><option value="1">min</option><option value="2">max</option><option value="3">count</option></select></label>
          <input type="search" id="tblsearch" placeholder="filter rows" aria-label="Filter rows">
          <button id="tblcsv" title="download the visible table as tab-separated text">TSV</button>
          <span class="muted" id="tblmeta"></span>
        </div>
        <div class="tablewrap"><table id="aggtable"></table></div>
      </section>
    </div>

    <div class="pane" id="pane-casts" hidden>
      <div class="cast-layout">
        <div class="castside">
          <div class="pane-tools compact">
            <span class="lbl">Select Cast Type</span>
            <div class="group seg small" id="castkind"><button data-k="all" class="on" title="every kind of cast">All</button><button data-k="CTD" title="the classic rosette's CTD casts">Rosette</button><button data-k="TM" title="the trace-metal rosette's casts">TM</button><button data-k="MVP" title="moving vessel profiler tows">MVP</button><button data-k="live" title="the cast in the water, from Seasave's TCP/IP output">Live</button></div>
            <div class="castfilter"><button id="castclear" title="deselect all">clear selection</button><input type="search" id="castsearch" placeholder="filter (station, label, date)" aria-label="Filter casts"><button id="castcsv" title="download the visible casts as tab-separated text">TSV</button></div>
          </div>
          <div class="tablewrap castlist" id="castlist"><table id="casttable"></table></div>
        </div>
        <div class="castmain">
          <div class="pane-tools compact">
            <span class="lbl">Select Graph</span>
            <div class="group seg" id="castmode"><button data-m="single" title="one cast, variables overlaid on their own axes">Single</button><button data-m="profiles" class="on" title="the selected casts as depth profiles, one graph per variable">Multi</button><button data-m="section" title="the selected casts side by side as a depth section along time or distance">Section</button></div>
            <button type="button" id="castbottles" class="chip" title="mark the rosette's bottle firings on the casts (from the SeaBird .btl files)">Bottles</button>
            <button type="button" id="castsmooth" class="chip" title="smooth the jittery sensors (fluorescence, CDOM, transmission, nitrates) down each profile: a running mean over 7 to 21 m by depth range">Smooth</button>
            <span class="muted" id="castmeta"></span>
          </div>
          <div class="pane-tools compact" id="castrow2" hidden>
            <div class="group sectionx" id="castxmode" aria-label="Section x axis"><span class="lbl">X-axis</span><button type="button" class="xcycle" title="the section's x axis: time, distance along the profiles in time order, the stations A–Z, or a custom order you arrange with the chips">Time</button></div>
            <label class="group select" id="castvarwrap">Color by <select id="castvar"></select></label>
          </div>
          <div class="castplots" id="castplots"><div class="empty">Select casts from the list, or click stations and tow tracks on the map.</div></div>
        </div>
      </div>
    </div>

    <div class="pane" id="pane-calendar" hidden>
      <div class="pane-tools">
        <div class="group seg" id="calview"><button data-v="agenda" class="on">Today</button><button data-v="timeline">Event Log</button><button data-v="month">Calendar</button></div>
        <input type="search" id="calsearch" placeholder="filter events" aria-label="Filter events">
      </div>
      <div id="calendar"></div>
    </div>

    <div class="pane" id="pane-stations" hidden>
      <div class="pane-tools">
        <input type="search" id="stnsearch" placeholder="filter stations" aria-label="Filter stations">
        <button id="stnclear" title="deselect every cast and drop the map focus">clear selection</button>
        <button id="stncsv" title="download the visible table as tab-separated text">TSV</button>
        <span class="muted" id="stnmeta"></span>
      </div>
      <div class="tablewrap"><table id="stationtable"></table></div>
    </div>

    <!-- the Wiki: the region's past and its nature in one pane; the two labels filter it, one or both on -->
    <div class="pane histpane" id="pane-wiki" hidden>
      <div class="pane-tools compact histtools">
        <button type="button" id="histback" class="chip histback" title="back to the view before">‹ Back</button>
        <button type="button" id="histhome" class="chip" title="the front page: today, here, the journal, the domains and the narratives">Home</button>
        <button type="button" id="histexplore" class="chip histexplore" title="every topic, with its pages and artifacts">Explore</button>
        <span class="domset" id="wikidomains" role="group" aria-label="What the wiki shows">
          <button type="button" class="chip dom on" data-domain="history" aria-pressed="true" title="the human past: voyages, people, places and artifacts">History</button>
          <button type="button" class="chip dom on" data-domain="nature" aria-pressed="true" title="the natural record: subjects, observations, the domains and the ship's journal">Nature</button>
        </span>
        <button type="button" id="histask" class="chip ask" title="ask the crew in the chat">Ask Crew</button>
        <input type="search" id="histsearch" class="histsearch" placeholder="search: voyages, people, places, species, ice, weather" aria-label="Search the wiki">
        <select id="histkindsel" class="histsel" aria-label="Browse a kind, a domain or a page" title="everything of a kind on one page; the bibliography; how the wiki was made; the record; the ship's journal"></select>
      </div>
      <article class="histmain" id="histmain"><div class="empty">Loading the wiki…</div></article>
    </div>

    <div class="pane card" id="pane-sources" hidden>
      <h2>Sources</h2>
      <div class="prov">
        <div class="meta">
          <span>Ship intranet: {% for l in site.intranet %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</span>
          <span>Calendars: {% for l in site.links %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</span>
          <span>Dashboard by Eric Collins · <a href="https://github.com/rec3141/underway" target="_blank" rel="noopener">source</a> · Data: Amundsen Science (ACSD)</span>
          <span class="right">underway v{{ site.version }} · built <time id="gen"></time></span>
        </div>
        <div class="hscroll"><table id="sources"></table></div>
        <div class="notes" id="notes"></div>
      </div>
    </div>
  </section>
  <dialog id="feedback-dialog" aria-labelledby="feedback-title">
    <form id="feedback-form">
      <h2 id="feedback-title">Feedback about this page</h2>
      <p>Report a problem or suggest an improvement. The current page and view settings are included.</p>
      <p id="feedback-page" class="muted"></p>
      <label for="feedback-message">Your feedback</label>
      <textarea id="feedback-message" rows="6" maxlength="5000" required></textarea>
      <label for="feedback-name">Name (optional)</label>
      <input id="feedback-name" maxlength="100" autocomplete="name">
      <p id="feedback-status" role="status" aria-live="polite"></p>
      <div class="feedback-actions"><button type="button" id="feedback-close">Cancel</button><button type="submit" id="feedback-send">Submit feedback</button></div>
    </form>
  </dialog>
</main>

<script>
window.__SITE__ = {{ site|tojson }};
window.__MANIFEST__ = {{ m|tojson }};
</script>
<aside class="chat collapsed" id="chat" aria-label="ship chat">
  <div class="chathead">
    <button class="chattoggle" id="chathead"><span class="dot" id="chatdot"></span><b id="chattitle">Ship</b> <span class="muted" id="chatwho">…</span><span class="badge" id="chatunread" hidden></span><span class="caret">▴</span></button>
    <button class="chatside" id="chatsidebtn" title="open as a side bar">⇤</button>
    <button class="chatclose" id="chatclosebtn" title="close the chat">✕</button>
  </div>
  <div class="chatbody">
    <div class="chatrooms" id="chatrooms" role="tablist" aria-label="chat rooms"></div>
    <div class="chatpicker" id="chatpicker" hidden></div>
    <div class="chatlog" id="chatlog"></div>
    <div class="chattyping muted" id="chattyping" hidden></div>
    <div class="chatcrew muted" id="chatcrew" hidden></div>
    <form class="chatform" id="chatform" autocomplete="off">
      <button type="button" class="emojibtn" id="chatemoji" title="pick your emoji">🙂</button>
      <input id="chatname" placeholder="name" maxlength="24" title="your name, remembered on this device">
      <input id="chattext" placeholder="message · Enter to send" maxlength="500" aria-label="Message">
      <button type="submit" title="send">➤</button>
    </form>
    <div class="emojipick" id="emojipick" hidden></div>
  </div>
</aside>

<script src="static/data.js?v={{ site.asset_version }}"></script>
<script src="static/map.js?v={{ site.asset_version }}"></script>
<script src="static/app.js?v={{ site.asset_version }}"></script>
<link rel="stylesheet" href="static/ice.css?v={{ site.asset_version }}">
<script src="static/ice.js?v={{ site.asset_version }}"></script>
<script src="static/intranet-live.js?v={{ site.asset_version }}"></script>
<script src="static/tabs.js?v={{ site.asset_version }}"></script>
<script src="static/history.js?v={{ site.asset_version }}"></script>
<script src="static/nature.js?v={{ site.asset_version }}"></script>
<script src="static/chat.js?v={{ site.asset_version }}"></script>
<script src="static/feedback.js?v={{ site.asset_version }}"></script>
</body>
</html>
