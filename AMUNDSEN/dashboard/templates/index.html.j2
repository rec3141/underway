<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site.title }}</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%230f1419'/%3E%3Cpath d='M6 20 Q11 14 16 18 T26 14' stroke='%235cc8ff' stroke-width='3' fill='none'/%3E%3C/svg%3E">
<link rel="stylesheet" href="static/style.css?v={{ site.asset_version }}">
<script src="static/plotly.min.js?v={{ site.plotly_version }}"></script>
</head>
<body>

<header class="top">
  <div class="brand">
    <h1>{{ site.title }}</h1>
    <div class="sub" id="status">loading…</div>
    <div class="sub" id="connection" role="status" hidden></div>
  </div>
  <nav class="tabs" id="tabs" role="tablist">
    <button data-tab="underway" class="on" role="tab">Underway</button>
    <button data-tab="casts" role="tab">Casts</button>
    <button data-tab="calendar" role="tab">Agenda</button>
    <button data-tab="table" role="tab">Table</button>
    <button data-tab="chat" role="tab" id="tabchat" title="ship chat">Chat</button>
  </nav>
  <div class="controls" id="controls-underway">
    <details class="group legmenu" id="legmenu">
      <summary id="legsummary">Legs</summary>
      <div class="pop">
        <div class="pophead">Legs to show · <a href="#" id="legall">all</a> · <a href="#" id="legnone">none</a></div>
        <ul id="leglist"></ul>
        <div class="popfoot" id="legfoot"></div>
      </div>
    </details>
    <div class="group span" aria-label="Time span">
      <span class="lbl">Span</span>
      <input type="range" id="span" min="0" max="0" step="1" value="0" list="spanticks">
      <datalist id="spanticks"></datalist>
      <output id="spanlabel" for="span">6h</output>
    </div>
  </div>
</header>
<div class="alertbar" id="alert" hidden>
  <span class="tag">schedule update</span><span id="alerttext"></span>
  <button id="alertgo">open agenda</button><button id="alertclose" title="dismiss">✕</button>
</div>

<main>
  <section class="map card">
    <div class="maptools">
      <button id="mapreset" title="fit to track">⟲</button>
      <label><input type="checkbox" id="stations" checked> CTD stations</label>
      <label title="geolocated entries of the ship's event log, for the shown legs and span"><input type="checkbox" id="events"> Event log</label>
      <label title="settlements (GeoNames, CC BY 4.0)"><input type="checkbox" id="communities" checked> Communities</label>
    </div>
    <div id="map"></div>
    <div id="mapmsg" class="mapmsg" hidden></div>
    <div class="map-foot" id="mapfoot"></div>
  </section>

  <section class="side">
    <div class="pane" id="pane-underway">
      <div class="pane-tools compact">
        <div class="group seg xmode" aria-label="X axis"><button data-x="time" class="on">Time</button><button data-x="distance">Distance</button></div>
        <label class="group select">Colour by <select id="colour"></select></label>
      </div>
      <div class="panels" id="panels"></div>
      <div class="dock" id="dock" hidden></div>
    </div>

    <div class="pane" id="pane-casts" hidden>
      <div class="cast-layout">
        <div class="castside">
          <div class="pane-tools compact">
            <div class="group seg small" id="castkind"><button data-k="all" class="on">All</button><button data-k="CTD" title="Classic rosette">Rosette</button><button data-k="TM" title="trace-metal rosette">TM</button><button data-k="MVP">MVP</button></div>
            <input type="search" id="castsearch" placeholder="filter (station, label, date)">
            <button id="castclear" title="deselect all">clear</button>
          </div>
          <ul class="castlist" id="castlist"></ul>
        </div>
        <div class="castmain">
          <div class="pane-tools compact">
            <div class="group seg" id="castmode"><button data-m="profiles" class="on">Profiles</button><button data-m="section">Section</button><button data-m="single" title="one cast, variables overlaid on their own axes">Single</button><button data-m="live" title="the cast in the water, from the deck unit's network feed">Live</button></div>
            <div class="group seg xmode" id="castxmode" aria-label="Section x axis" hidden><button data-x="time" class="on">Time</button><button data-x="distance">Distance</button></div>
            <label class="group select" id="castvarwrap" hidden>Variable <select id="castvar"></select></label>
            <span class="muted" id="castmeta"></span>
          </div>
          <div class="castplots" id="castplots"><div class="empty">Select casts from the list, or click stations and tow tracks on the map.</div></div>
        </div>
      </div>
    </div>

    <div class="pane" id="pane-calendar" hidden>
      <div class="pane-tools">
        <div class="group seg" id="calview"><button data-v="agenda" class="on">Agenda</button><button data-v="timeline">Timeline</button><button data-v="month">Calendar</button></div>
        <input type="search" id="calsearch" placeholder="filter events">
        <span class="muted" id="calmeta"></span>
      </div>
      <div id="calendar"></div>
    </div>

    <div class="pane" id="pane-table" hidden>
      <div class="pane-tools">
        <div class="group seg" id="aggrule"><button data-r="stations" class="on">Stations</button><button data-r="1h">Hourly</button><button data-r="1d">Daily</button></div>
        <label class="group select">Statistic <select id="aggstat"><option value="0">mean</option><option value="1">min</option><option value="2">max</option><option value="3">count</option></select></label>
        <input type="search" id="tblsearch" placeholder="filter rows">
        <button id="tblcsv" title="download the visible table as CSV">CSV</button>
        <span class="muted" id="tblmeta"></span>
      </div>
      <div class="tablewrap"><table id="aggtable"></table></div>
    </div>

    <footer>
      <details class="card">
        <summary>Data sources &amp; provenance</summary>
        <div class="prov">
          <table id="sources"></table>
          <div class="notes" id="notes"></div>
        </div>
      </details>
      <div class="meta">
        <span>Ship intranet: {% for l in site.intranet %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</span>
        <span>Dashboard by Eric Collins · Data: Amundsen Science (ACSD) · Basemap: Natural Earth{% if site.raster %} · GEBCO 2024{% endif %}</span>
        {% for l in site.links %}<span>· <a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a></span>{% endfor %}
        <span class="right">underway v{{ site.version }} · <time id="gen"></time></span>
      </div>
    </footer>
  </section>
</main>

<script>
window.__SITE__ = {{ site|tojson }};
window.__MANIFEST__ = {{ m|tojson }};
</script>
<aside class="chat collapsed" id="chat" aria-label="ship chat">
  <div class="chathead">
    <button class="chattoggle" id="chathead"><span class="dot" id="chatdot"></span><b>Chat</b> <span class="muted" id="chatwho">…</span><span class="badge" id="chatunread" hidden></span><span class="caret">▴</span></button>
    <button class="chatside" id="chatsidebtn" title="open as a side bar">⇤</button>
  </div>
  <div class="chatbody">
    <div class="chatlog" id="chatlog"></div>
    <div class="chattyping muted" id="chattyping" hidden></div>
    <div class="chatcrew muted" id="chatcrew" hidden></div>
    <form class="chatform" id="chatform" autocomplete="off">
      <button type="button" class="emojibtn" id="chatemoji" title="pick your emoji">🙂</button>
      <input id="chatname" placeholder="name" maxlength="24" title="your name, remembered on this device">
      <input id="chattext" placeholder="message · Enter to send" maxlength="500">
      <button type="submit" title="send">➤</button>
    </form>
    <div class="emojipick" id="emojipick" hidden></div>
  </div>
</aside>

<script src="static/data.js?v={{ site.asset_version }}"></script>
<script src="static/app.js?v={{ site.asset_version }}"></script>
<script src="static/tabs.js?v={{ site.asset_version }}"></script>
<script src="static/chat.js?v={{ site.asset_version }}"></script>
</body>
</html>
