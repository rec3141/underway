# Copy to ~/.config/underway/camera.env after confirming paths.
# The source is one leg directory (YYYYMMDD folders inside) or the directory
# holding the legs; with the latter every leg builds into OUTPUT/<leg>/.
UNDERWAY_CAMERA_SOURCE=/mnt/ship/Data/Camera_360
UNDERWAY_CAMERA_OUTPUT=/data/underway/camera360
UNDERWAY_CAMERA_PYTHON=/opt/miniforge3/bin/python3
UNDERWAY_CAMERA_INTERVAL=120
# portrait (9:16, the three cameras stacked) or mosaic; width defaults 720 / 1280
UNDERWAY_CAMERA_LAYOUT=portrait
UNDERWAY_CAMERA_WIDTH=720
# Daily copy to the leg's photo folder: which leg of OUTPUT, and the existing destination.
UNDERWAY_CAMERA_SYNC_LEG=2026_LEG_03
UNDERWAY_CAMERA_SHARE=/mnt/ship/Share/2026/2026_LEG_03/Pictures/Timelapse
