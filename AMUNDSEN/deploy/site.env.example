# This installation of the underway dashboard: where it lives and who runs it.
#
# Copy to /etc/underway/site.env, edit, then run `sudo deploy/install.sh`, which
# fills the unit files in deploy/ from these values and installs them. The units
# also read this file into their environment each time they start, and the
# shell tools source it: a changed value reaches a timer's job on its next run,
# a server on its restart, and a unit file on the next install.sh.
#
# The format is shared by systemd and bash: KEY=value, no spaces around '=',
# comments on their own lines only (systemd would read a trailing '# ...' as
# part of the value). Nothing secret belongs here (the file is world-readable):
# secrets go in $UNDERWAY_CONFIG/underway.env, from deploy/underway.env.example.

# The installation's directory: app/ (a clone of the repository on master, what
# the services run), db/, cache/, www/, chat/ and camera360/ (state, never in git)
UNDERWAY_HOME=/data/underway_server

# The account the services run as; it owns UNDERWAY_HOME
UNDERWAY_USER=cryomics

# The interpreter with the dashboard's packages (pip install -e 'app/AMUNDSEN[chat,gcal]')
UNDERWAY_PYTHON=/opt/miniforge3/bin/python3

# The account's own settings: underway.env (every secret), gcal-sa.json (the
# Google key), admins.json (chat names that may clear review flags); defaults
# to ~UNDERWAY_USER/.config/underway
#UNDERWAY_CONFIG=/home/cryomics/.config/underway

# The local mirror of the ship's shares that the build reads (tools/mirror-share.sh)
UNDERWAY_MIRROR=/data/ship

# Raster tiles for the map (tools/make_gebco_tiles.sh writes them)
UNDERWAY_TILES_DIR=/data/gis/tiles

# The arctic-history clone behind the Wiki tab, and where tools/history-pull.sh
# pulls it from (an ssh host and path); without a clone the tab is simply absent
ARCTIC_HISTORY_ROOT=/data/dev/arctic-history
ARCTIC_HISTORY_REMOTE=grid:/data/dev/arctic-history

# The page server's port (Caddy on :80 proxies to it, deploy/Caddyfile)
UNDERWAY_PORT=8042

# The network interface on the ship's Wi-Fi: underway.local is published on it,
# and tools/ship-routes.sh falls back to its gateway
UNDERWAY_IFACE=wlo1
UNDERWAY_MDNS_NAME=underway.local

TZ=America/Toronto

# The camera timelapses (underway-camera.timer, underway-camera-sync.timer).
# The source is one leg directory (YYYYMMDD folders inside) or the directory
# holding the legs; with the latter every leg builds into camera360/<leg>/
UNDERWAY_CAMERA_SOURCE=/mnt/ship/Data/Camera_360
UNDERWAY_CAMERA_INTERVAL=120
# portrait (9:16, the three cameras stacked) or mosaic; width defaults 720 / 1280
UNDERWAY_CAMERA_LAYOUT=portrait
UNDERWAY_CAMERA_WIDTH=720
# the daily copy to the leg's photo folder: which leg, and the existing destination;
# change both at the start of each leg
UNDERWAY_CAMERA_SYNC_LEG=2026_LEG_03
UNDERWAY_CAMERA_SHARE=/mnt/ship/Share/2026/2026_LEG_03/Pictures/Timelapse
