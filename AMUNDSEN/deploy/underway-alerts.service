[Unit]
Description=Send the underway dashboard's schedule alerts (Telegram, email)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cryomics
Group=cryomics
WorkingDirectory=/home/cryomics/Desktop/underway/AMUNDSEN
Environment=TZ=America/Toronto
EnvironmentFile=-/home/cryomics/.config/underway/underway.env
ExecStart=/opt/miniforge3/bin/python3 -m dashboard alerts
TimeoutStartSec=4min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/home/cryomics/Desktop/underway/AMUNDSEN
StandardOutput=journal
StandardError=journal
