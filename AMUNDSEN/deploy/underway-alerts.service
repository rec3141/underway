[Unit]
Description=Send the underway dashboard's schedule alerts (Telegram, email)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cryomics
Group=cryomics
WorkingDirectory=/data/underway/app/AMUNDSEN
Environment=UNDERWAY_DB_DIR=/data/underway/db
Environment=UNDERWAY_CACHE_DIR=/data/underway/cache
# numpy's BLAS starts a thread per core at import (32 here) and that alone costs 8 s CPU a run
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
Environment=TZ=America/Toronto
EnvironmentFile=-/home/cryomics/.config/underway/underway.env
ExecStart=/opt/miniforge3/bin/python3 -m dashboard alerts
TimeoutStartSec=4min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/data/underway/app/AMUNDSEN
ReadWritePaths=/data/underway/db /data/underway/cache
StandardOutput=journal
StandardError=journal
