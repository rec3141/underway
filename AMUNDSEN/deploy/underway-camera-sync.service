[Unit]
Description=Daily copy of camera timelapse to leg photos
After=network-online.target

[Service]
Type=oneshot
User=@UNDERWAY_USER@
WorkingDirectory=@UNDERWAY_HOME@/app/AMUNDSEN
EnvironmentFile=@UNDERWAY_SITE@
Environment=UNDERWAY_DB_DIR=@UNDERWAY_HOME@/db
Environment=UNDERWAY_CACHE_DIR=@UNDERWAY_HOME@/cache
Environment=UNDERWAY_CAMERA_OUTPUT=@UNDERWAY_HOME@/camera360
EnvironmentFile=@UNDERWAY_CONFIG@/camera.env
ExecStart=/bin/bash tools/camera-job.sh sync
TimeoutStartSec=15min
Nice=15
NoNewPrivileges=true
