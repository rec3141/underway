[Unit]
Description=Underway Dashboard static server
After=network-online.target
Wants=network-online.target

[Service]
Environment=UNDERWAY_TILES_DIR=/data/gis/tiles
Environment=TZ=America/Toronto
Type=simple
WorkingDirectory=/data/underway/app/AMUNDSEN
Environment=UNDERWAY_DB_DIR=/data/underway/db
Environment=UNDERWAY_CACHE_DIR=/data/underway/cache
ExecStart=/opt/miniforge3/bin/python3 -m dashboard serve --root /data/underway/www --port 8042
Restart=on-failure
User=cryomics
Group=cryomics

[Install]
WantedBy=multi-user.target
