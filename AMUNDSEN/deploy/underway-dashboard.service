[Unit]
Description=Underway Dashboard static server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@UNDERWAY_USER@
Group=@UNDERWAY_GROUP@
WorkingDirectory=@UNDERWAY_HOME@/app/AMUNDSEN
EnvironmentFile=@UNDERWAY_SITE@
Environment=UNDERWAY_DB_DIR=@UNDERWAY_HOME@/db
Environment=UNDERWAY_CACHE_DIR=@UNDERWAY_HOME@/cache
Environment=UNDERWAY_WEBROOT=@UNDERWAY_HOME@/www
Environment=UNDERWAY_CHAT_DB=@UNDERWAY_HOME@/chat/chat.sqlite
Environment=UNDERWAY_CAMERA_OUTPUT=@UNDERWAY_HOME@/camera360
ExecStart=@UNDERWAY_PYTHON@ -m dashboard serve --root @UNDERWAY_HOME@/www --port @UNDERWAY_PORT@
Restart=on-failure

[Install]
WantedBy=multi-user.target
