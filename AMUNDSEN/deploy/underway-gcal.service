[Unit]
Description=Push the underway dashboard's queued Google Calendar items
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cryomics
Group=cryomics
WorkingDirectory=/home/cryomics/Desktop/underway/AMUNDSEN
# numpy's BLAS starts a thread per core at import (32 here) and that alone costs 8 s CPU a run
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
Environment=TZ=America/Toronto
ExecStart=/opt/miniforge3/bin/python3 -m dashboard gcal-push
TimeoutStartSec=8min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/home/cryomics/Desktop/underway/AMUNDSEN
StandardOutput=journal
StandardError=journal
