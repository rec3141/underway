[Unit]
Description=Underway experimental live sampling adviser
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/underway-livesample/app
EnvironmentFile=-%h/.config/underway/underway.env
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=NUMBA_NUM_THREADS=1
ExecStart=%h/.local/share/underway-livesample/venv/bin/python -m dashboard.livesample --root /data/underway_server/www --state-dir %h/.local/share/underway-livesample/state --port 8043
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
