[Unit]
Description=Publish underway.local (mDNS alias) for the underway dashboard
After=avahi-daemon.service network-online.target
Wants=network-online.target avahi-daemon.service

[Service]
ExecStart=@UNDERWAY_HOME@/app/AMUNDSEN/tools/publish-mdns.sh @UNDERWAY_MDNS_NAME@ @UNDERWAY_IFACE@
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
