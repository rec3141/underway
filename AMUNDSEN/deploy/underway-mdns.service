[Unit]
Description=Publish underway.local (mDNS alias) for the underway dashboard
After=avahi-daemon.service network-online.target
Wants=network-online.target avahi-daemon.service

[Service]
ExecStart=/home/cryomics/Desktop/underway/AMUNDSEN/tools/publish-mdns.sh underway.local wlo1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
