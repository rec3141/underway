[Unit]
Description=Answer the underway dashboard's Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@UNDERWAY_USER@
Group=@UNDERWAY_GROUP@
WorkingDirectory=@UNDERWAY_HOME@/app/AMUNDSEN
EnvironmentFile=@UNDERWAY_SITE@
Environment=UNDERWAY_DB_DIR=@UNDERWAY_HOME@/db
Environment=UNDERWAY_CACHE_DIR=@UNDERWAY_HOME@/cache
Environment=UNDERWAY_WEBROOT=@UNDERWAY_HOME@/www
Environment=UNDERWAY_CHAT_DB=@UNDERWAY_HOME@/chat/chat.sqlite
EnvironmentFile=-@UNDERWAY_CONFIG@/underway.env
ExecStart=@UNDERWAY_PYTHON@ -m dashboard telegram-bot
Restart=always
RestartSec=10
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=@UNDERWAY_HOME@
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
