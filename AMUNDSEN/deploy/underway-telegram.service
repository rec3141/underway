[Unit]
Description=Answer the underway dashboard's Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cryomics
Group=cryomics
WorkingDirectory=/data/underway/app/AMUNDSEN
Environment=UNDERWAY_DB_DIR=/data/underway/db
Environment=UNDERWAY_CACHE_DIR=/data/underway/cache
Environment=TZ=America/Toronto
EnvironmentFile=-/home/cryomics/.config/underway/underway.env
ExecStart=/opt/miniforge3/bin/python3 -m dashboard telegram-bot
Restart=always
RestartSec=10
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/data/underway/app/AMUNDSEN
ReadWritePaths=/data/underway/db /data/underway/cache
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
