# The dashboard's secrets, every one of them. Copy to ~/.config/underway/underway.env
# (or $UNDERWAY_CONFIG/underway.env) as the service account, `chmod 600` it, and
# fill in what you have: each integration is off, and the page says so, while
# its values are missing. The units load it into their environment when they
# start; restart underway-dashboard and underway-telegram after an edit.
# KEY=value, comments on their own lines. The other secret is a file: the Google
# service-account key, gcal-sa.json, in the same directory.

# Telegram: the bot's token (from @BotFather) and the keeper's own chat id
# (operations alerts and the chat's model notices go there)
TELEGRAM_KEY=
TELEGRAM_ID=

# Email for alerts: an SMTP account (Gmail: smtp.gmail.com, 465, an app password).
# SMTP_SSL=0 means STARTTLS on 587. SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=1
SMTP_REPLY_TO=

# Where operations alerts (a stalled FULL_CSV, review flags) are mailed;
# defaults to SMTP_USER
UNDERWAY_OPS_EMAIL=

# Sentinel imagery: an OAuth client of a Copernicus Data Space account
COPERNICUS_ID=
COPERNICUS_SECRET=
