[Unit]
Description=Amundsen Underway Dashboard generator
Wants=network-online.target
After=network-online.target
# No RequiresMountsFor: the build reads the local mirror, not the share

[Service]
Type=oneshot
User=@UNDERWAY_USER@
Group=@UNDERWAY_GROUP@
WorkingDirectory=@UNDERWAY_HOME@/app/AMUNDSEN
# the installation's settings (UNDERWAY_MIRROR, UNDERWAY_TILES_DIR, ARCTIC_HISTORY_ROOT, TZ, ...)
EnvironmentFile=@UNDERWAY_SITE@
# numpy's BLAS starts a thread per core at import (32 here) and that alone costs 8 s CPU a run
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
Environment=UNDERWAY_LOCAL=1
Environment=UNDERWAY_WEBROOT=@UNDERWAY_HOME@/www
Environment=UNDERWAY_DB_DIR=@UNDERWAY_HOME@/db
Environment=UNDERWAY_CACHE_DIR=@UNDERWAY_HOME@/cache
Environment=UNDERWAY_CHAT_DB=@UNDERWAY_HOME@/chat/chat.sqlite
# credentials; create it mode 600
EnvironmentFile=-@UNDERWAY_CONFIG@/underway.env
ExecStart=@UNDERWAY_HOME@/app/AMUNDSEN/update_underway_py.sh
# Nice I/O to be friendly on shared storage
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=@UNDERWAY_HOME@
# the mirror and the history clone may sit under /home, which is otherwise
# read-only here; SQLite writes its journal beside the history database.
# '-': a path that does not exist is skipped, not a failure to start
ReadWritePaths=-@UNDERWAY_MIRROR@ -@ARCTIC_HISTORY_ROOT@/db
# Restrict networking surface (still allows HTTP/HTTPS)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
# Logging
StandardOutput=journal
StandardError=journal
